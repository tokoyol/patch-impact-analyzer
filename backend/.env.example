# Copy this file to .env and fill in values.
# Never commit .env to the repository.

# --- Database ---
# Local Postgres (default if unset):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/patchdb

# Neon (recommended for cloud):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-quiet-snow-a8xwokgy-pooler.eastus2.azure.neon.tech/neondb?sslmode=require

# --- LLM fallback (optional) ---
# LLM_PROVIDER=gemini          # gemini | openai | ollama
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Ollama -> Gemini auto-fallback:
# LLM_ENABLE_GEMINI_FALLBACK=true
# LLM_LOW_CONFIDENCE_MIN_COVERAGE=0.45

# --- Bootstrap ---
# Set to false to skip auto-ingesting JSON files on startup (render-start.sh only)
# AUTO_BOOTSTRAP_PATCH_DATA=true
